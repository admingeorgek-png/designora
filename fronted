<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Designora — Creative Design Studio</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --blue: #155eef;
  --purple: #7c3aed;
  --dark: #172033;
  --muted: #667085;
  --light: #f6f8fc;
  --border: #e4e7ec;
  --white: #ffffff;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--light);
  color: var(--dark);
}

/* HEADER */
header {
  height: 70px;
  background: white;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 25px;
  gap: 35px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 21px;
  font-weight: 900;
  color: var(--blue);
  white-space: nowrap;
}

.logo span {
  color: var(--purple);
}

nav {
  display: flex;
  gap: 25px;
  flex: 1;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-weight: 600;
  cursor: pointer;
}

nav a:hover {
  color: var(--blue);
}

.header-buttons {
  display: flex;
  gap: 10px;
}

button {
  border: none;
  cursor: pointer;
  font-family: inherit;
}

.btn {
  padding: 11px 17px;
  border-radius: 10px;
  font-weight: 700;
}

.primary {
  color: white;
  background: linear-gradient(135deg, var(--blue), var(--purple));
}

.secondary {
  background: white;
  border: 1px solid var(--border);
}

/* HERO */
.hero {
  max-width: 1200px;
  margin: auto;
  padding: 75px 25px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.badge {
  display: inline-block;
  background: #eef4ff;
  color: var(--blue);
  padding: 8px 13px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 700;
}

.hero h1 {
  font-size: 64px;
  line-height: 1;
  margin: 20px 0;
}

.gradient-text {
  background: linear-gradient(90deg, var(--blue), var(--purple));
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
}

.hero p {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
  max-width: 550px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  margin-top: 30px;
}

/* DESIGN PREVIEW */
.preview-wrapper {
  padding: 25px;
  background: #e8edff;
  border-radius: 30px;
  transform: rotate(2deg);
  box-shadow: 0 25px 70px rgba(30, 50, 100, .15);
}

.preview-toolbar {
  background: white;
  height: 45px;
  border-radius: 12px 12px 0 0;
  padding: 13px;
  font-weight: 800;
}

.preview {
  height: 430px;
  border-radius: 0 0 12px 12px;
  background: linear-gradient(145deg, #155eef, #7c3aed);
  color: white;
  padding: 55px;
  position: relative;
  overflow: hidden;
}

.preview h2 {
  font-size: 55px;
  line-height: .9;
  position: relative;
  z-index: 2;
}

.preview p {
  color: white;
  margin-top: 20px;
  position: relative;
  z-index: 2;
}

.circle {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(255,255,255,.13);
  right: -100px;
  top: -80px;
}

/* DASHBOARD */
#dashboard {
  display: none;
  max-width: 1200px;
  margin: auto;
  padding: 45px 25px;
}

.dashboard-title h1 {
  font-size: 40px;
  margin: 12px 0;
}

.dashboard-title p {
  color: var(--muted);
}

.format-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin: 35px 0 55px;
}

.format {
  background: white;
  border: 1px solid var(--border);
  padding: 23px;
  border-radius: 18px;
  cursor: pointer;
  transition: .2s;
}

.format:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0,0,0,.08);
}

.format-icon {
  font-size: 30px;
  color: var(--blue);
  margin-bottom: 12px;
}

.format strong {
  display: block;
  font-size: 17px;
}

.format small {
  color: var(--muted);
}

/* EDITOR */
#editor {
  display: none;
  height: calc(100vh - 70px);
  background: #edf0f5;
}

.editor-toolbar {
  height: 60px;
  background: white;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 18px;
  gap: 12px;
}

.editor-title {
  flex: 1;
  font-weight: 700;
}

.editor-toolbar button {
  padding: 9px 14px;
  border-radius: 8px;
  background: #f2f4f7;
  font-weight: 700;
}

.editor-toolbar .share {
  background: var(--purple);
  color: white;
}

.editor-toolbar .download {
  background: var(--blue);
  color: white;
}

.editor-body {
  height: calc(100% - 60px);
  display: grid;
  grid-template-columns: 75px 260px 1fr 230px;
}

/* LEFT TOOLBAR */
.tools {
  background: white;
  border-right: 1px solid var(--border);
  padding: 10px 7px;
}

.tool {
  width: 100%;
  background: transparent;
  padding: 14px 4px;
  border-radius: 10px;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  gap: 5px;
  align-items: center;
  font-weight: 700;
}

.tool:hover,
.tool.active {
  background: #eef4ff;
  color: var(--blue);
}

.tool-icon {
  font-size: 21px;
}

/* PANEL */
.side-panel {
  background: white;
  border-right: 1px solid var(--border);
  padding: 20px;
  overflow-y: auto;
}

.side-panel h3 {
  margin-bottom: 15px;
}

.search {
  width: 100%;
  padding: 11px;
  border: 1px solid #d0d5dd;
  border-radius: 9px;
  margin-bottom: 18px;
}

.template-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.template {
  aspect-ratio: 4/5;
  border-radius: 10px;
  padding: 15px;
  color: white;
  font-weight: 900;
  cursor: pointer;
}

.template:nth-child(1) {
  background: linear-gradient(145deg,#155eef,#7c3aed);
}

.template:nth-child(2) {
  background: linear-gradient(145deg,#111827,#475467);
}

.template:nth-child(3) {
  background: linear-gradient(145deg,#f97316,#ef4444);
}

.template:nth-child(4) {
  background: linear-gradient(145deg,#059669,#155eef);
}

/* CANVAS */
.canvas-area {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  padding: 35px;
}

.canvas {
  width: 420px;
  height: 560px;
  background: #155eef;
  position: relative;
  padding: 55px;
  color: white;
  box-shadow: 0 20px 50px rgba(0,0,0,.18);
  overflow: hidden;
}

.canvas-circle {
  position: absolute;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
  right: -110px;
  top: -70px;
}

.canvas-title {
  position: relative;
  z-index: 2;
  font-size: 56px;
  font-weight: 900;
  line-height: .9;
  outline: none;
}

.canvas-subtitle {
  position: absolute;
  bottom: 55px;
  left: 55px;
  font-weight: 600;
}

/* PROPERTIES */
.properties {
  background: white;
  border-left: 1px solid var(--border);
  padding: 20px;
}

.properties h3 {
  margin-bottom: 25px;
}

.property {
  margin-bottom: 22px;
}

.property label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 8px;
}

.property input {
  width: 100%;
}

.color-input {
  height: 45px;
  padding: 0;
  border: 1px solid var(--border);
}

/* FEATURES */
.features {
  max-width: 1100px;
  margin: 20px auto 80px;
  padding: 25px;
}

.features h2 {
  text-align: center;
  font-size: 35px;
  margin-bottom: 35px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.feature {
  background: white;
  padding: 25px;
  border-radius: 18px;
  border: 1px solid var(--border);
}

.feature-icon {
  font-size: 30px;
  margin-bottom: 15px;
}

.feature h3 {
  margin-bottom: 8px;
}

.feature p {
  color: var(--muted);
  line-height: 1.5;
}

/* MOBILE */
@media(max-width: 850px) {

  nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 45px;
  }

  .hero h1 {
    font-size: 48px;
  }

  .format-grid {
    grid-template-columns: 1fr 1fr;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .editor-body {
    grid-template-columns: 60px 200px 1fr;
  }

  .properties {
    display: none;
  }

  .canvas {
    width: 320px;
    height: 430px;
  }

  .canvas-title {
    font-size: 42px;
  }
}

@media(max-width: 550px) {

  header {
    padding: 0 15px;
  }

  .header-buttons .secondary {
    display: none;
  }

  .hero {
    padding: 45px 18px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .preview {
    height: 330px;
    padding: 40px;
  }

  .preview h2 {
    font-size: 42px;
  }

  .format-grid {
    grid-template-columns: 1fr;
  }

  .side-panel {
    display: none;
  }

  .editor-body {
    grid-template-columns: 60px 1fr;
  }

  .canvas-area {
    padding: 20px;
  }

  .canvas {
    width: 300px;
    height: 400px;
    padding: 40px;
  }
}
</style>
</head>

<body>

<!-- HEADER -->
<header>
  <div class="logo">✦ DESIGNORA<span>.</span></div>

  <nav>
    <a onclick="showHome()">Home</a>
    <a onclick="showDashboard()">Templates</a>
    <a onclick="showDashboard()">Projects</a>
    <a onclick="showDashboard()">Brand Kit</a>
  </nav>

  <div class="header-buttons">
    <button class="btn secondary" onclick="showDashboard()">Explore</button>
    <button class="btn primary" onclick="openEditor()">Create Design</button>
  </div>
</header>

<!-- HOME -->
<section id="home">

  <main class="hero">

    <div>
      <span class="badge">✨ Your creative workspace</span>

      <h1>
        Design anything.<br>
        <span class="gradient-text">Make it yours.</span>
      </h1>

      <p>
        Create beautiful social media graphics, posters,
        presentations and business designs with a simple,
        powerful creative workspace.
      </p>

      <div class="hero-actions">
        <button class="btn primary" onclick="openEditor()">
          Start designing →
        </button>

        <button class="btn secondary" onclick="showDashboard()">
          Explore templates
        </button>
      </div>
    </div>

    <div class="preview-wrapper">
      <div class="preview-toolbar">
        ✦ Designora
        <span style="float:right">•••</span>
      </div>

      <div class="preview">
        <div class="circle"></div>

        <h2>
          CREATE<br>
          YOUR<br>
          STORY
        </h2>

        <p>Make every idea count.</p>
      </div>
    </div>

  </main>

  <section class="features">

    <h2>Everything you need to create</h2>

    <div class="feature-grid">

      <div class="feature">
        <div class="feature-icon">🎨</div>
        <h3>Beautiful Designs</h3>
        <p>Create professional designs with colors, text, shapes and templates.</p>
      </div>

      <div class="feature">
        <div class="feature-icon">⚡</div>
        <h3>Fast & Simple</h3>
        <p>Start creating in seconds without complicated design software.</p>
      </div>

      <div class="feature">
        <div class="feature-icon">✨</div>
        <h3>Creative Tools</h3>
        <p>Build social posts, posters, business graphics and much more.</p>
      </div>

    </div>

  </section>

</section>

<!-- DASHBOARD -->
<section id="dashboard">

  <div class="dashboard-title">
    <span class="badge">Your workspace</span>

    <h1>What will you create today?</h1>

    <p>
      Choose a format and bring your next idea to life.
    </p>
  </div>

  <div class="format-grid">

    <div class="format" onclick="openEditor()">
      <div class="format-icon">▣</div>
      <strong>TikTok</strong>
      <small>1080 × 1920</small>
    </div>

    <div class="format" onclick="openEditor()">
      <div class="format-icon">▧</div>
      <strong>Instagram</strong>
      <small>1080 × 1350</small>
    </div>

    <div class="format" onclick="openEditor()">
      <div class="format-icon">▶</div>
      <strong>YouTube</strong>
      <small>1920 × 1080</small>
    </div>

    <div class="format" onclick="openEditor()">
      <div class="format-icon">▤</div>
      <strong>Poster</strong>
      <small>1080 × 1350</small>
    </div>

  </div>

  <h2>Recent designs</h2>

  <div style="
    height:220px;
    background:white;
    border:2px dashed #d8dee9;
    border-radius:20px;
    display:grid;
    place-items:center;
    color:#98a2b3;
    margin-top:18px;
  ">
    Your saved designs will appear here.
  </div>

</section>

<!-- EDITOR -->
<section id="editor">

  <div class="editor-toolbar">

    <button onclick="showDashboard()">←</button>

    <div class="editor-title">
      Untitled design
    </div>

    <button>↶</button>
    <button>↷</button>

    <button class="share">
      Share
    </button>

    <button class="download" onclick="downloadDesign()">
      Download
    </button>

  </div>

  <div class="editor-body">

    <!-- TOOLS -->
    <aside class="tools">

      <button class="tool active">
        <span class="tool-icon">▦</span>
        Design
      </button>

      <button class="tool" onclick="addText()">
        <span class="tool-icon">T</span>
        Text
      </button>

      <button class="tool">
        <span class="tool-icon">◇</span>
        Elements
      </button>

      <button class="tool">
        <span class="tool-icon">↑</span>
        Uploads
      </button>

      <button class="tool">
        <span class="tool-icon">◆</span>
        Brand
      </button>

    </aside>

    <!-- DESIGN PANEL -->
    <aside class="side-panel">

      <h3>Design</h3>

      <input
        class="search"
        placeholder="Search templates"
      >

      <h4 style="margin-bottom:12px;">
        Templates
      </h4>

      <div class="template-grid">

        <div class="template" onclick="changeTemplate(1)">
          CREATE<br>
          YOUR<br>
          STORY
        </div>

        <div class="template" onclick="changeTemplate(2)">
          YOUR<br>
          IDEA<br>
          MATTERS
        </div>

        <div class="template" onclick="changeTemplate(3)">
          DREAM<br>
          BIG
        </div>

        <div class="template" onclick="changeTemplate(4)">
          KEEP<br>
          GOING
        </div>

      </div>

    </aside>

    <!-- CANVAS -->
    <main class="canvas-area">

      <div class="canvas" id="canvas">

        <div class="canvas-circle"></div>

        <div
          id="canvasTitle"
          class="canvas-title"
          contenteditable="true"
        >
          YOUR<br>
          STORY<br>
          STARTS<br>
          HERE
        </div>

        <div class="canvas-subtitle">
          Believe in the next step.
        </div>

      </div>

    </main>

    <!-- PROPERTIES -->
    <aside class="properties">

      <h3>Properties</h3>

      <div class="property">

        <label>Text Size</label>

        <input
          type="range"
          min="20"
          max="100"
          value="56"
          oninput="changeSize(this.value)"
        >

      </div>

      <div class="property">

        <label>Text Color</label>

        <input
          class="color-input"
          type="color"
          value="#ffffff"
          oninput="changeTextColor(this.value)"
        >

      </div>

      <div class="property">

        <label>Background</label>

        <input
          class="color-input"
          type="color"
          value="#155eef"
          oninput="changeBackground(this.value)"
        >

      </div>

      <div class="property">

        <button
          class="btn primary"
          style="width:100%"
          onclick="addText()"
        >
          + Add Text
        </button>

      </div>

    </aside>

  </div>

</section>

<script>

function hideAll() {
  document.getElementById("home").style.display = "none";
  document.getElementById("dashboard").style.display = "none";
  document.getElementById("editor").style.display = "none";
}

function showHome() {
  hideAll();
  document.getElementById("home").style.display = "block";
  window.scrollTo(0,0);
}

function showDashboard() {
  hideAll();
  document.getElementById("dashboard").style.display = "block";
  window.scrollTo(0,0);
}

function openEditor() {
  hideAll();
  document.getElementById("editor").style.display = "block";
}

function changeSize(size) {
  document.getElementById("canvasTitle").style.fontSize = size + "px";
}

function changeTextColor(color) {
  document.getElementById("canvasTitle").style.color = color;
}

function changeBackground(color) {
  document.getElementById("canvas").style.background = color;
}

function addText() {

  const canvas = document.getElementById("canvas");

  const newText = document.createElement("div");

  newText.innerText = "New Text";

  newText.contentEditable = true;

  newText.style.position = "absolute";
  newText.style.left = "55px";
  newText.style.top = "280px";
  newText.style.fontSize = "32px";
  newText.style.fontWeight = "800";
  newText.style.zIndex = "10";
  newText.style.outline = "none";

  canvas.appendChild(newText);

  newText.focus();
}

function changeTemplate(number) {

  const title = document.getElementById("canvasTitle");
  const canvas = document.getElementById("canvas");

  if(number === 1) {
    title.innerHTML = "CREATE<br>YOUR<br>STORY<br>";
    canvas.style.background =
      "linear-gradient(145deg,#155eef,#7c3aed)";
  }

  if(number === 2) {
    title.innerHTML = "YOUR<br>IDEA<br>MATTERS";
    canvas.style.background =
      "linear-gradient(145deg,#111827,#475467)";
  }

  if(number === 3) {
    title.innerHTML = "DREAM<br>BIG";
    canvas.style.background =
      "linear-gradient(145deg,#f97316,#ef4444)";
  }

  if(number === 4) {
    title.innerHTML = "KEEP<br>GOING";
    canvas.style.background =
      "linear-gradient(145deg,#059669,#155eef)";
  }

}

function downloadDesign() {

  alert(
    "The design editor is working. PNG/PDF export will be added in the next version."
  );

}

</script>

</body>
</html>
